# Local .terraform directories (contains huge provider binaries)
**/.terraform/*

# Local state files (your state lives safely in S3, never in Git)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive variable files (commit a terraform.tfvars.example instead!)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
